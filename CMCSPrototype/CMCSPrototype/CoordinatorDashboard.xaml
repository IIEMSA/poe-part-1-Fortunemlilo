<Page x:Class="CMCSPrototype.CoordinatorDashboard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Coordinator Dashboard" Background="White">
    <Grid>
        <TextBlock Text="Pending Claims" FontSize="18" Margin="10,10,0,0"/>

        <!-- DataGrid to display pending claims -->
        <DataGrid x:Name="dataGridPendingClaims" Margin="10,40,10,0" AutoGenerateColumns="False" SelectionChanged="OnClaimSelected">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Claim ID" Binding="{Binding ClaimID}"/>
                <DataGridTextColumn Header="Lecturer Name" Binding="{Binding LecturerName}"/>
                <DataGridTextColumn Header="Claim Amount" Binding="{Binding ClaimAmount, StringFormat=C}"/>
                <DataGridTextColumn Header="Submission Date" Binding="{Binding SubmissionDate}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Claim Approval/Reject Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,250,0,0" VerticalAlignment="Top">
            <Button Content="Approve Claim" Width="120" Margin="0,0,10,0" Click="ApproveClaim_Click"/>
            <Button Content="Reject Claim" Width="120" Click="RejectClaim_Click"/>
        </StackPanel>

        <!-- Uploaded Documents Section -->
        <GroupBox Header="Uploaded Documents" Margin="10,300,10,0" Height="150">
            <ListBox x:Name="listBoxDocuments" Margin="10"/>
        </GroupBox>
    </Grid>
</Page>
