<Page x:Class="CMCSPrototype.LecturerDashboard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Lecturer Dashboard" Background="White">
    <Grid>
        <TextBlock Text="Submit New Claim" FontSize="20" Margin="10"/>

        <!-- Claim Submission Form -->
        <StackPanel Margin="10,50,10,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Hours Worked:" Width="120" VerticalAlignment="Center"/>
                <TextBox Width="200"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Hourly Rate:" Width="120" VerticalAlignment="Center"/>
                <TextBox Width="200"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Claim Amount:" Width="120" VerticalAlignment="Center"/>
                <TextBlock Width="200" Text="Auto-calculated"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button Content="Upload Supporting Documents" Width="200"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button Content="Submit Claim" Width="120" Height="30"/>
            </StackPanel>
        </StackPanel>

        <!-- Claims History DataGrid -->
        <TextBlock Text="Claims History" FontSize="18" Margin="10,220,0,0"/>
        <DataGrid Margin="10,250,10,10" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Claim ID" Width="100"/>
                <DataGridTextColumn Header="Claim Amount" Width="150"/>
                <DataGridTextColumn Header="Submission Date" Width="200"/>
                <DataGridTextColumn Header="Status" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
